# ローカル動作用テンプレ（実キーは Vercel の Environment Variables に設定。このファイルはコミットOK）
OPENAI_API_KEY=your-dashscope-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_FALLBACK=qwen-plus,qwen-max,qwen-turbo,qwen-long,qwen-flash,qwen3.8-flash

# ログイン機能（Vercel Redis 連携で自動付与される。未設定時はログイン無効・匿名2回/日）
# 変数名は連携の「Custom Prefix」設定で変わる。コードは両方に対応している（_lib/storage.mjs）
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-redis-token
# 接頭辞なし（既定）の場合はこちらが注入される:
# KV_REST_API_URL=https://xxx.upstash.io
# KV_REST_API_TOKEN=your-redis-token
# LOGGED_DAILY_LIMIT=5

# メール認証（新規登録の6桁コード送信／Resend）。未設定時は新規登録が 503 で止まる
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=noreply@coverletterkit.com
# RESEND_REPLY_TO=contact@coverletterkit.com
